# ---------------------------------------------------------------------------
# Data products. These are regenerated by running the pipeline, and are far
# too large for git - the merged ntuple alone is over 1 GB, and GitHub
# rejects any single file above 100 MB.
# ---------------------------------------------------------------------------
*.root
*.dst
ntuples/
ntuples_*/

# Per-chunk DaVinci logs and the resume markers that go with them.
logs/
logs_*/
*.done
failed_chunks.txt

# Generated plots. Remove this section if you want the figures in the repo -
# a handful of PNGs is fine, and useful for anyone reading the README.
# Alternatively keep a curated few in figures/ and ignore the rest.
*.png
*.pdf
!figures/*.png

# The open data file index, if downloaded by hand from the record page.
*_file_index.json
*_file_index.txt
*_LFNS.txt

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

